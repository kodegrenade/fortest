    "test:package": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@fortest/engine": "workspace:*",
    "@fortest/types": "workspace:*",
    "@fortest/utils": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
