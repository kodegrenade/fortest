{
  "name": "@codegrenade/fortest-cli",
  "version": "0.3.0",
  "private": true,
  "description": "Run Fortest API flow tests (exported buckets or Postman collections) from the command line and CI.",
  "license": "MIT",
  "main": "./src/cli.ts",
  "exports": {
    ".": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
